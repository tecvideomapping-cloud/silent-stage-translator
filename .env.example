# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Conexões Railway Nativas (injetadas automaticamente pelo Railway quando adicionados os plugins)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
REDIS_URL=redis://default:password@localhost:6379

# Provedores de IA (Opcionais - caso não preenchidos, o sistema opera em MOCK_AI=true)
MOCK_AI=false

# 1. Speech-to-Text em Tempo Real (Recomendado: Deepgram)
DEEPGRAM_API_KEY=

# 2. Tradução com IA (Recomendado: OpenAI GPT-4o-mini, Groq Llama 3.3, ou DeepL)
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPL_API_KEY=

# 3. Text-to-Speech de Baixa Latência (Recomendado: Cartesia Sonic ou ElevenLabs)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
