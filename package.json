{
  "name": "videomappingtech-silent-translator",
  "version": "1.0.2",
  "description": "Plataforma de Palestras Silenciosas e TraduÃƒÂ§ÃƒÂ£o SimultÃƒÂ¢nea com IA em Tempo Real",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "desktop": "electron desktop/main.js",
    "desktop:web": "node desktop/main.js",
    "pack:win": "electron-builder --win nsis",
    "dist:win": "electron-builder --win",
    "pack:mac": "electron-builder --mac",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64",
    "dist:mac:x64": "electron-builder --mac dmg --x64",
    "test": "node --test scripts/*.test.js"
  },
  "build": {
    "appId": "com.videomappingtech.silentstage",
    "productName": "Silent Stage AI",
    "asarUnpack": ["desktop/speech/worker.py"],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silent Stage AI"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "server/**/*",
      "package.json",
      "!desktop/.vmt-*",
      "!desktop/**/__pycache__/**",
      "!desktop/speech/test_*.py",
      "!**/.env",
      "!**/*.dpapi"
    ]
  },
  "keywords": [
    "silent-theater",
    "ai-translation",
    "realtime-audio",
    "subtitles",
    "railway"
  ],
  "author": "videomappingtech",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "msedge-tts": "^2.1.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
